# Figuur 25 – Totaal model gedecomponeerd gebouw
# Sluitstuk dat de modellen van figuur 21 (functioneel/technisch), figuur 23 (roerend/onroerend)
# en figuur 24 (fysieke decompositie) samenvoegt. Toont de volledige klassenhiërarchie
# met slechts de kerninstanties uit het diagram.

@prefix ex-ont: <http://data.organization.com/def/> .
@prefix ex-data: <http://data.organization.com/id/> .
@prefix nen2660: <https://w3id.org/nen2660/def#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.organization.com/def/figuur25/> a owl:Ontology ;
    rdfs:label "Gebouwontologie - Figuur 25"@nl ;
    owl:versionInfo "0.1"^^xsd:string ;
    dct:date "2026-07-02"^^xsd:date ;
    owl:imports <https://w3id.org/nen2660/rdfs/def> .

# --- Klassen: functionele entiteiten ---

ex-ont:Appartementencomplex a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Appartementencomplex"@nl .

ex-ont:OnroerendGoed a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Onroerend goed"@nl ;
    skos:definition "Vaste bestanddelen van een gebouw die niet verplaatsbaar zijn."@nl .

ex-ont:RoerendGoed a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Roerend goed"@nl ;
    skos:definition "Losse objecten die verplaatsbaar zijn."@nl .

ex-ont:Binnenplaats a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Binnenplaats"@nl .

ex-ont:Parkeergelegenheid a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Parkeergelegenheid"@nl .

ex-ont:Etage a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Etage"@nl .

ex-ont:Hal a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Hal"@nl .

ex-ont:Trappenhuis a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "Trappenhuis"@nl .

# --- Klassen: fysieke constructie en ruimtelijke gebieden ---

ex-ont:Gebouw a rdfs:Class ;
    rdfs:subClassOf nen2660:PhysicalObject ;
    skos:prefLabel "Gebouw"@nl .

ex-ont:Gebouwconstructie a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    rdfs:subClassOf nen2660:DiscreteObject ;
    skos:prefLabel "Gebouwconstructie"@nl .

ex-ont:InpandigeRuimte a rdfs:Class ;
    rdfs:subClassOf nen2660:SpatialRegion ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Inpandige ruimte"@nl .

ex-ont:Binnenplaatsruimte a rdfs:Class ;
    rdfs:subClassOf ex-ont:InpandigeRuimte ;
    skos:prefLabel "Binnenplaatsruimte"@nl .

ex-ont:Parkeergarageruimte a rdfs:Class ;
    rdfs:subClassOf ex-ont:InpandigeRuimte ;
    skos:prefLabel "Parkeergarageruimte"@nl .

ex-ont:Etageruimte a rdfs:Class ;
    rdfs:subClassOf ex-ont:InpandigeRuimte ;
    skos:prefLabel "Etageruimte"@nl .

ex-ont:Halruimte a rdfs:Class ;
    rdfs:subClassOf ex-ont:InpandigeRuimte ;
    skos:prefLabel "Halruimte"@nl .

ex-ont:Trappenhuisruimte a rdfs:Class ;
    rdfs:subClassOf ex-ont:InpandigeRuimte ;
    skos:prefLabel "Trappenhuisruimte"@nl .

ex-ont:Pannendak a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Pannendak"@nl .

ex-ont:Deur a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Deur"@nl .

ex-ont:Raam a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Raam"@nl .

ex-ont:Vloer a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Vloer"@nl .

ex-ont:Keukenblok a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Keukenblok"@nl .

ex-ont:Wand a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    skos:prefLabel "Wand"@nl .

ex-ont:Meubel a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity ;
    rdfs:subClassOf nen2660:DiscreteObject ;
    skos:prefLabel "Meubel"@nl .

# --- Instanties (gele blokken in het diagram) ---

# Het appartementencomplex als functionele entiteit.
ex-data:Appartementencomplex_abcd a ex-ont:Appartementencomplex .

# De fysieke implementaties van het complex: het gebouw en de constructie.
ex-data:Appartementencomplex_gebouw_efgh a nen2660:PhysicalObject .
ex-data:Gebouwconstructie_grsf a ex-ont:Gebouwconstructie .

# Roerend goed: meubels die het complex bevat maar geen vast bouwdeel zijn.
ex-data:Kast_hjk a ex-ont:Meubel .
ex-data:Tafel_uvwx a ex-ont:Meubel .

# --- Relaties ---

# Het functionele appartementencomplex wordt geïmplementeerd door het gebouw en de constructie.
ex-data:Appartementencomplex_abcd nen2660:isImplementedBy ex-data:Appartementencomplex_gebouw_efgh,
                                                           ex-data:Gebouwconstructie_grsf .

# Roerend goed via contains (bevat): niet-vaste objecten binnen het complex.
ex-data:Appartementencomplex_abcd nen2660:contains ex-data:Kast_hjk,
                                                    ex-data:Tafel_uvwx .
