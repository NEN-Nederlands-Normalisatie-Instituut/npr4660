@prefix ex-ont: <http://data.organization.com/def/> .
@prefix ex-data: <http://data.organization.com/id/> .
@prefix nen2660: <https://w3id.org/nen2660/def#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.organization.com/def/figuur9/> a owl:Ontology ;
    rdfs:label "Gebouwontologie - Figuur 9 (OWL)"@nl ;
    owl:versionInfo "0.1"^^xsd:string ;
    dct:date "2026-07-02"^^xsd:date ;
    owl:imports <https://w3id.org/nen2660/rdfs/def> .

ex-ont:Gebouw a owl:Class ;
    skos:definition "Bouwwerk dat begrensd, betreedbaar en afsluitbaar is."@nl, "A structure that is enclosed, accessible and lockable."@en ;
    skos:prefLabel "Gebouw"@nl , "Building"@en ;
    rdfs:subClassOf nen2660:PhysicalObject ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty nen2660:hasPart ;
        owl:someValuesFrom ex-ont:DiscreetGebouw
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty nen2660:hasPart ;
        owl:someValuesFrom ex-ont:InpandigeRuimteGebouw
    ] .

ex-ont:InpandigeRuimteGebouw a rdfs:Class ;
    rdfs:subClassOf nen2660:SpatialRegion .

ex-ont:DiscreetGebouw a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:Etageruimte a rdfs:Class ;
    rdfs:subClassOf nen2660:SpatialRegion ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex-ont:Gipswand a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex-data:Gebouw_123 a ex-ont:Gebouw .

ex-data:DiscreetGebouw_123 a ex-ont:DiscreetGebouw .

ex-data:InpandigeRuimteGebouw_123 a ex-ont:InpandigeRuimteGebouw .

ex-data:Gipswand_123 a ex-ont:Gipswand .

ex-data:Etageruimte_123 a ex-ont:Etageruimte .

ex-data:Gebouw_123 nen2660:hasPart ex-data:DiscreetGebouw_123,
                                    ex-data:InpandigeRuimteGebouw_123 .

ex-data:InpandigeRuimteGebouw_123 nen2660:hasPart ex-data:Etageruimte_123 .

ex-data:DiscreetGebouw_123 nen2660:hasPart ex-data:Gipswand_123 .
