@prefix ex: <http://example.org/id/> .
@prefix nen2660: <https://w3id.org/nen2660/def#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

ex:DiscreetGebouw a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex:Kunstvoorwerp a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex:GipsWand a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex:VentilatieSysteemEenheid a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex:Ventilator a rdfs:Class ; 
    rdfs:subClassOf nen2660:DiscreteObject .

ex:DraagConstructie a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex:DragendeWand a rdfs:Class ; 
    rdfs:subClassOf nen2660:DiscreteObject .

ex:Bouwdeel a rdfs:Class ; 
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "VERA 4.1 Bouwdeel"@nl ;
    dct:source <https://www.coraveraonline.nl/index.php/Id-d8a421c6-6b1d-d52a-afc7-a247bea2022c> .

ex:BouwkundigElement a rdfs:Class ; 
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "VERA 4.1 BouwkundigElement"@nl ;
    dct:source <https://www.coraveraonline.nl/index.php/Id-d8a421c6-6b1d-d52a-afc7-a247bea2022c> .

ex:DraagConstructie_123 a ex:DraagConstructie .

ex:VentilatieSysteem_123 a ex:VentilatieSysteemEenheid .

ex:DragendeWand_123 a ex:DragendeWand .

ex:Ventilator_123 a ex:Ventilator .

ex:Bouwdeel_GipsWand_123 a ex:Bouwdeel .
ex:Bouwdeel_kunstvoorwerp_456 a ex:Bouwdeel .
ex:Bouwdeel_DraagConstructie_789 a ex:Bouwdeel . 
ex:Bouwdeel_VentilatieSysteem_abc a ex:Bouwdeel .
ex:Bouwkundigelement_Ventilator_bcd a ex:BouwkundigElement . 
ex:Bouwkundigelement_DragendeWand_def a ex:BouwkundigElement .

ex:DiscreetGebouw_123 a ex:DiscreetGebouw ;
    nen2660:hasPart ex:Kunstvoorwerp_123,
                          ex:GipsWand_123,
                                  ex:VentilatieSysteem_123,
                                        ex:DraagConstructie_123 . 
        
ex:Kunstvoorwerp_123 a ex:Kunstvoorwerp ;
                        ex:naam "Muurmozaïek"@nl .
    
ex:GipsWand_123 a ex:GipsWand .
        
ex:DraagConstructie_123 nen2660:hasPart ex:DragendeWand_123 .

ex:Bouwdeel_GipsWand_123 nen2660:isImplementedBy ex:GipsWand_123 .  
ex:Bouwdeel_kunstvoorwerp_456 nen2660:isImplementedBy ex:Kunstvoorwerp_123 . 
ex:Bouwdeel_DraagConstructie_789 nen2660:isImplementedBy ex:DraagConstructie_123 .
ex:Bouwdeel_VentilatieSysteem_abc nen2660:isImplementedBy ex:VentilatieSysteem_123 .
ex:Bouwkundigelement_Ventilator_bcd nen2660:isImplementedBy ex:Ventilator_123 .
ex:Bouwkundigelement_DragendeWand_def nen2660:isImplementedBy ex:DragendeWand_123 . 

ex:Bouwdeel_DraagConstructie_789 nen2660:hasPart ex:Bouwkundigelement_DragendeWand_def .
ex:Bouwdeel_VentilatieSysteem_abc nen2660:hasPart ex:Bouwkundigelement_Ventilator_bcd .
