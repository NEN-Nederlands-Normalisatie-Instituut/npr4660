@prefix ex-ont: <http://data.organization.com/def/> .
@prefix ex-data: <http://data.organization.com/id/> .
@prefix nen2660: <https://w3id.org/nen2660/def#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.organization.com/def/figuur10/> a owl:Ontology ;
    rdfs:label "Gebouwontologie - Figuur 10"@nl ;
    owl:versionInfo "0.1"^^xsd:string ;
    dct:date "2026-07-02"^^xsd:date ;
    owl:imports <https://w3id.org/nen2660/rdfs/def> .

ex-ont:DiscreetGebouw a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:Kunstvoorwerp a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex-ont:GipsWand a rdfs:Class ;
    rdfs:subClassOf nen2660:TechnicalEntity .

ex-ont:VentilatieSysteemEenheid a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:Ventilator a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:DraagConstructie a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:DragendeWand a rdfs:Class ;
    rdfs:subClassOf nen2660:DiscreteObject .

ex-ont:Bouwdeel a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "VERA 4.1 Bouwdeel"@nl ;
    dct:source <https://www.coraveraonline.nl/index.php/Id-d8a421c6-6b1d-d52a-afc7-a247bea2022c> .

ex-ont:BouwkundigElement a rdfs:Class ;
    rdfs:subClassOf nen2660:FunctionalEntity ;
    skos:prefLabel "VERA 4.1 BouwkundigElement"@nl ;
    dct:source <https://www.coraveraonline.nl/index.php/Id-d8a421c6-6b1d-d52a-afc7-a247bea2022c> .

ex-ont:naam a rdf:Property ;
    skos:prefLabel "Naam"@nl, "Name"@en .

ex-ont:BouwdeelShape a sh:NodeShape ;
    sh:targetClass ex-ont:Bouwdeel ;
    sh:property [
        sh:path nen2660:isImplementedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Een Bouwdeel moet precies één implementatie hebben."@nl ;
    ] .

ex-ont:BouwkundigElementShape a sh:NodeShape ;
    sh:targetClass ex-ont:BouwkundigElement ;
    sh:property [
        sh:path nen2660:isImplementedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Een BouwkundigElement moet precies één implementatie hebben."@nl ;
    ] .

ex-data:DraagConstructie_123 a ex-ont:DraagConstructie .

ex-data:VentilatieSysteem_123 a ex-ont:VentilatieSysteemEenheid .

ex-data:DragendeWand_123 a ex-ont:DragendeWand .

ex-data:Ventilator_123 a ex-ont:Ventilator .

ex-data:Bouwdeel_GipsWand_123 a ex-ont:Bouwdeel .
ex-data:Bouwdeel_kunstvoorwerp_456 a ex-ont:Bouwdeel .
ex-data:Bouwdeel_DraagConstructie_789 a ex-ont:Bouwdeel .
ex-data:Bouwdeel_VentilatieSysteem_abc a ex-ont:Bouwdeel .
ex-data:Bouwkundigelement_Ventilator_bcd a ex-ont:BouwkundigElement .
ex-data:Bouwkundigelement_DragendeWand_def a ex-ont:BouwkundigElement .

ex-data:DiscreetGebouw_123 a ex-ont:DiscreetGebouw ;
    nen2660:hasPart ex-data:Kunstvoorwerp_123,
                    ex-data:GipsWand_123,
                    ex-data:VentilatieSysteem_123,
                    ex-data:DraagConstructie_123 .

ex-data:Kunstvoorwerp_123 a ex-ont:Kunstvoorwerp ;
    ex-ont:naam "Muurmozaïek"@nl .

ex-data:GipsWand_123 a ex-ont:GipsWand .

ex-data:DraagConstructie_123 nen2660:hasPart ex-data:DragendeWand_123 .

ex-data:Bouwdeel_GipsWand_123 nen2660:isImplementedBy ex-data:GipsWand_123 .
ex-data:Bouwdeel_kunstvoorwerp_456 nen2660:isImplementedBy ex-data:Kunstvoorwerp_123 .
ex-data:Bouwdeel_DraagConstructie_789 nen2660:isImplementedBy ex-data:DraagConstructie_123 .
ex-data:Bouwdeel_VentilatieSysteem_abc nen2660:isImplementedBy ex-data:VentilatieSysteem_123 .
ex-data:Bouwkundigelement_Ventilator_bcd nen2660:isImplementedBy ex-data:Ventilator_123 .
ex-data:Bouwkundigelement_DragendeWand_def nen2660:isImplementedBy ex-data:DragendeWand_123 .

ex-data:Bouwdeel_DraagConstructie_789 nen2660:hasPart ex-data:Bouwkundigelement_DragendeWand_def .
ex-data:Bouwdeel_VentilatieSysteem_abc nen2660:hasPart ex-data:Bouwkundigelement_Ventilator_bcd .
